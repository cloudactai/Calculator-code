# Copy this file to .env for local development.
# Only ANTHROPIC_API_KEY is required for the Flask backend (app.py).
# The auth-server reads DATABASE_URL and JWT_SECRET from its own environment
# (or from this file if you run it from the repo root with dotenv).

# ── Flask backend (app.py) ──────────────────────────────────────────────────

# Required: Anthropic API credential for all AI chat and report features.
ANTHROPIC_API_KEY=

# Optional: override the Claude model (defaults to claude-sonnet-4-6).
# CLAUDE_MODEL=claude-sonnet-4-6

# Optional: Anthropic messages endpoint (defaults to the SDK default).
# CLAUDE_MESSAGE_ENDPOINT=https://api.anthropic.com/v1/messages

# Optional: fallback model if the primary is unavailable.
# CLAUDE_FALLBACK_MODEL=claude-haiku-4-5-20251001

# ── Auth server (auth-server/server.js) ─────────────────────────────────────

# PostgreSQL connection string. The auth-server is the only service that
# touches the database. SSL is auto-enabled for *.rds.amazonaws.com hosts.
# DATABASE_URL=postgresql://user:password@host:5432/dbname

# Secret used to sign session JWTs. Pick a long random string.
# Rotating it logs everyone out.
# JWT_SECRET=

# The exact frontend origin (no trailing slash). Used for CORS and email links.
# FRONTEND_URL=http://localhost:3000

# Must be "production" in production; otherwise session cookies are dropped.
# NODE_ENV=development

# ── Email (Microsoft Graph, used by auth-server) ────────────────────────────

# These four values authenticate app-only Graph calls for sending
# verification and password-reset email. Optional for local dev — email
# features will fail gracefully without them.
# EMAIL_MICROSOFT_TENANT_ID=
# EMAIL_MICROSOFT_CLIENT_ID=
# EMAIL_MICROSOFT_CLIENT_SECRET=
# EMAIL_MICROSOFT_SENDER_EMAIL=notifications@cloudforlawfirms.com

# Whether new signups must verify their email before use.
# Set to false for local development convenience.
# EMAIL_VERIFICATION_REQUIRED=false
