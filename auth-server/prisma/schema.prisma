// Personal-build schema: auth (User) + per-user app data (matters and saved
// calculations, migrated off the legacy law-firm /v1 backend into this
// Postgres). No Subscriber/law-firm, no Clio/QBO token columns.
//
// Postgres via the pg adapter (see prismaClient.js). DATABASE_URL supplies the
// connection string for both the CLI (below) and the runtime adapter.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String  @id @default(uuid())
  email        String  @unique
  name         String?
  jobTitle     String?
  profilePic   String? // optional base64 data URL for an avatar
  passwordHash String

  // Personal profile fields edited on the Profile page.
  firstName       String?
  lastName        String?
  phoneNumber     String?
  description     String? // the free-text "Job Title" on the profile page
  signature       String? // optional base64 data URL for a signature image
  // Mailing address (kept separate from the hard-coded calculator region so
  // editing it here never affects family-law calculations).
  street          String?
  addressProvince String?
  country         String?

  // Email verification
  emailVerifiedAt            DateTime?
  emailVerificationTokenHash String?
  emailVerificationExpiresAt DateTime?

  // Password reset
  resetPasswordTokenHash String?
  resetPasswordExpiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matters                  Matter[]
  savedCalculations        SavedCalculation[]
  calculationReports       MatterCalculationReport[]
  lawyerContacts           LawyerContact[]
  matterAgreementDocuments MatterAgreementDocument[]
}

// The user's lawyer address book. Populated from the "Lawyer Addressbook"
// modal on the Background information form and used to auto-fill the lawyer
// block for a party (see cloudact-ui .../LawyerAddressBookModal.jsx). Holds
// both the firm's own lawyers and outside counsel - memberOfFirm says which.
model LawyerContact {
  id           Int      @id @default(autoincrement())
  userId       String
  name         String
  address      String?
  municipality String?
  province     String?
  postalCode   String?
  phone        String?
  email        String?
  memberOfFirm Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

// A family-law matter. Mirrors the legacy f_ca_matters row shape the UI
// expects (clientName is returned as client_id, checkedItems is a JSON
// string) - see auth-server/src/routes/mattersRoutes.js.
model Matter {
  id                   Int      @id @default(autoincrement())
  userId               String
  clientName           String
  matterNumber         String
  clientRole           String?
  childrenInvolved     String?
  province             String?
  checkedItems         String?
  source               String   @default("Internal")
  informationCompleted Int      @default(0)
  status               Int      @default(0)
  firstflag            Int      @default(1)
  valuationDate        String?
  fyIncomeBenefits     String?
  fyExpenses           String?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user               User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  records            MatterRecord[]
  folders            MatterFolder[]
  formDocuments      MatterFormDocument[]
  taskStates         MatterTaskState[]
  calculations       SavedCalculation[]        @relation("MatterCalculations")
  calculationReports MatterCalculationReport[]
  agreementDocuments MatterAgreementDocument[]

  @@unique([userId, matterNumber])
  @@index([userId])
}

// One JSON document per (matter, dataType): the row arrays the five-steps
// save produces (background, children, court, relationship, employment,
// income_benefits, expenses, special_expenses, debts_liabilities, opih,
// assets) plus folders/files metadata and per-file form data
// (file_data:<folderId>:<fileId>).
model MatterRecord {
  id        Int      @id @default(autoincrement())
  matterId  Int
  dataType  String
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@unique([matterId, dataType])
}

// A saved calculator run. Mirrors legacy tbl_calculator_values: `data` is the
// JSON string the calculator stores and re-parses on load.
model SavedCalculation {
  id             Int      @id @default(autoincrement())
  userId         String
  label          String
  description    String?
  taxYear        String?
  status         String?
  type           String?
  calculatorType String?
  matterId       String?
  matterDbId     Int?
  data           String?
  reportUrl      String?
  reportData     String?
  createdBy      String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  matter Matter? @relation("MatterCalculations", fields: [matterDbId], references: [id], onDelete: SetNull)

  @@unique([userId, label])
  @@index([userId])
  @@index([matterDbId])
}

model FormTemplate {
  id              Int                   @id @default(autoincrement())
  docId           String                @unique
  province        String
  category        String
  title           String
  shortTitle      String?
  fileName        String
  footerText      String?
  status          String                @default("active")
  productionReady Boolean               @default(false)
  mappingReady    Boolean               @default(false)
  sortOrder       Int                   @default(0)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  versions        FormTemplateVersion[]

  @@index([province, productionReady, mappingReady])
}

model FormTemplateVersion {
  id              Int                  @id @default(autoincrement())
  templateId      Int
  version         Int
  pdfBytes        Bytes?
  pdfPath         String?
  fieldMapping    Json?
  pageCount       Int?
  pdfChecksum     String?
  mappingChecksum String?
  effectiveDate   DateTime?
  active          Boolean              @default(true)
  createdAt       DateTime             @default(now())
  template        FormTemplate         @relation(fields: [templateId], references: [id], onDelete: Cascade)
  documents       MatterFormDocument[]

  @@unique([templateId, version])
  @@index([templateId, active])
}

model MatterFolder {
  id                 Int                       @id @default(autoincrement())
  matterId           Int
  title              String
  normalizedTitle    String
  type               String?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  matter             Matter                    @relation(fields: [matterId], references: [id], onDelete: Cascade)
  formDocuments      MatterFormDocument[]
  agreementDocuments MatterAgreementDocument[]

  @@unique([matterId, normalizedTitle])
  @@index([matterId])
}

model MatterFormDocument {
  id                   Int                     @id @default(autoincrement())
  matterId             Int
  folderId             Int?
  templateVersionId    Int
  displayName          String
  status               String                  @default("OPEN")
  fieldValues          Json                    @default("{}")
  fieldProvenance      Json                    @default("{}")
  generatedPdf         Bytes?
  generatedAt          DateTime?
  generatedPdfRevision Int                     @default(0)
  revision             Int                     @default(1)
  createdAt            DateTime                @default(now())
  updatedAt            DateTime                @updatedAt
  matter               Matter                  @relation(fields: [matterId], references: [id], onDelete: Cascade)
  folder               MatterFolder?           @relation(fields: [folderId], references: [id], onDelete: SetNull)
  templateVersion      FormTemplateVersion     @relation(fields: [templateVersionId], references: [id], onDelete: Restrict)
  pdfRevisions         MatterFormPdfRevision[]

  @@index([matterId, folderId])
}

model MatterFormPdfRevision {
  id         Int                  @id @default(autoincrement())
  documentId Int
  revision   Int
  checksum   String
  pdf        Bytes
  complete   Boolean              @default(true)
  createdAt  DateTime             @default(now())
  document   MatterFormDocument   @relation(fields: [documentId], references: [id], onDelete: Cascade)
  chunks     MatterFormPdfChunk[]

  @@unique([documentId, revision])
  @@index([documentId, createdAt])
}

model MatterFormPdfChunk {
  id         Int                   @id @default(autoincrement())
  revisionId Int
  position   Int
  pdf        Bytes
  revision   MatterFormPdfRevision @relation(fields: [revisionId], references: [id], onDelete: Cascade)

  @@unique([revisionId, position])
  @@index([revisionId, position])
}

model MatterTaskState {
  id        Int      @id @default(autoincrement())
  matterId  Int
  taskKey   String
  status    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  matter    Matter   @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@unique([matterId, taskKey])
}

// Tax constants by year. One row per tax year, storing the full constants
// object (brackets, credit amounts, benefit thresholds, etc.) as JSON.
// Seeded from tax_constants.json; edited via the super-admin Tax Constants page.
model TaxConstant {
  id        Int      @id @default(autoincrement())
  year      Int      @unique
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A saved calculation report with the generated PDF. Stores both the
// input/output data (so the report can be regenerated) and the PDF bytes
// (for instant download without re-running the calculation).
model MatterCalculationReport {
  id              Int      @id @default(autoincrement())
  userId          String
  matterId        Int
  calculationType String // "child_support", "spousal_support"
  taxYear         String?
  label           String? // user-friendly name, e.g. "Smith v Jones - Jan 2026"
  inputData       Json // calculation inputs (incomes, children, provinces, etc.)
  resultData      Json // calculation outputs (amounts, scenario, net payer, etc.)
  pdfBytes        Bytes? // the generated PDF report
  pdfFilename     String? // original filename for download headers
  createdAt       DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  matter Matter @relation(fields: [matterId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([matterId])
}

// A drafted agreement (Draft Agreements task). One row per (matter,
// agreementType) — the chat resumes across visits, so there is exactly one
// in-progress conversation per agreement type rather than a new row each time.
//
// `answers` is the chat-collected fields the agreement chat has gathered so
// far, keyed by section (see cloudact-ui .../agreementSections.js) — the
// source of truth for "what the chat already knows". `transcript` is the
// display-only bubble log rendered as history on resume. Neither is replayed
// to the model as literal prior turns: buildAgreementContextMessage() derives
// a fresh primer from live matter data + `answers` on every open, the same
// reasoning documented in auth-server/src/utils/changeLog.js for why Update
// Information never keeps its transcript either.
//
// Reset Chat (cloudact-ui AgreementChatPanel.jsx) clears `transcript` and
// `answers` on this row only — never MatterRecord, which this chat never
// writes to, and never `pdfBytes` once a PDF has been generated on purpose.
model MatterAgreementDocument {
  id            Int       @id @default(autoincrement())
  userId        String
  matterId      Int
  folderId      Int?
  agreementType String // "separation_agreement" — see AGREEMENT_TYPES registry
  answers       Json      @default("{}")
  transcript    Json      @default("[]")
  status        String    @default("draft") // "draft" | "final"
  revision      Int       @default(1)
  pdfBytes      Bytes?
  pdfFilename   String?
  generatedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  user   User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  matter Matter        @relation(fields: [matterId], references: [id], onDelete: Cascade)
  folder MatterFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)

  @@unique([matterId, agreementType])
  @@index([userId])
  @@index([matterId])
}
