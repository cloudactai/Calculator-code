# Copy to .env for local development. NEVER commit real values.
# Full documentation for every variable: docs/AUTH_HANDOFF/ENV_VARS.md

# Postgres connection string (Render Postgres in prod; local Postgres in dev)
DATABASE_URL=

# Long random secret that signs session JWTs.
# Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Exact frontend origin, no trailing slash. Used for CORS AND as the base of
# email links (verify / reset).
FRONTEND_URL=http://localhost:3000

# REQUIRED to be "production" on Render — otherwise the cross-domain session
# cookie is dropped by the browser. Leave unset locally (http -> SameSite=Lax).
# NODE_ENV=production

# Microsoft Graph email sender — copy the four values from the existing
# report-creation Render service (Environment tab). No Azure work needed.
EMAIL_MICROSOFT_TENANT_ID=
EMAIL_MICROSOFT_CLIENT_ID=
EMAIL_MICROSOFT_CLIENT_SECRET=
EMAIL_MICROSOFT_SENDER_EMAIL=notifications@cloudforlawfirms.com

# Optional: skip the email-verification step for local dev (new signups start
# verified). NOT a login bypass — see docs/AUTH_HANDOFF/README.md §7.
# EMAIL_VERIFICATION_REQUIRED=false

# Optional: override the primary session cookie name (default auth_token).
# AUTH_COOKIE_NAME=auth_token

# Optional: extra comma-separated allowed origins (e.g. a preview domain).
# FRONTEND_URLS=
