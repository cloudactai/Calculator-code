# Copy this file to .env (for local dev) or set these in your hosting provider's
# build environment (Vercel / Render / GitHub Actions). CRA only reads
# REACT_APP_* variables, and only at BUILD time — changing them requires a rebuild.

# Which backend the UI talks to: LOCAL | DEV | QA | PROD
REACT_APP_ENVIRONMENT=LOCAL

# Dev-only auth bypass: signs you in as a fake ADMIN so the UI can be explored
# without a backend (npm start only — has no effect in production builds).
# REACT_APP_DEV_BYPASS_AUTH=true

# Backend API base URLs (override only if they change — sensible defaults are in src/config.ts)
# REACT_APP_API_URL_LOCAL=http://localhost:3000/v1
# REACT_APP_API_URL_DEV=https://dev-cloudact.infoset.ca/v1
# REACT_APP_API_URL_QA=https://apicloudact.infoset.ca/v1
# REACT_APP_API_URL_PROD=https://api.cloudforlawfirms.com/v1

# Flask calculator/AI backend from this repo (app.py)
# REACT_APP_CALCULATOR_API_URL=https://calculator-code-x2b4.onrender.com

# Two-step setup wizard (Add Law Firm -> Connect Clio/QBO) backend.
# These hit the /api/* auth routes (the cloudact_api_auth_patch). Leave blank
# for same-origin; set to the backend ORIGIN (absolute URL) when the UI is on a
# different domain — the OAuth start/disconnect URLs are derived from the
# oauth-status origin, so it MUST be absolute for cross-origin to work.
# REACT_APP_API_BACKEND_URL_LAW_FIRM=https://<backend>/api/law-firm
# REACT_APP_API_BACKEND_URL_OAUTH_STATUS=https://<backend>/api/oauth/status
# REACT_APP_API_BACKEND_URL_LOGOUT=https://<backend>/api/logout

# Power BI embedding — REQUIRED for the operational dashboard.
# Get real values from the Azure AD app registration. NEVER commit them.
REACT_APP_POWERBI_CLIENT_ID=
REACT_APP_POWERBI_CLIENT_SECRET=
REACT_APP_POWERBI_TENANT_ID=
REACT_APP_POWERBI_REPORT_ID=
REACT_APP_POWERBI_GROUP_ID=
# REACT_APP_POWER_BI_API=api.powerbi.com
# REACT_APP_POWERBI_AUTHORITY=https://login.microsoftonline.com/
# REACT_APP_POWERBI_GRANT_TYPE=client_credentials
# REACT_APP_POWERBI_SCOPE=https://analysis.windows.net/powerbi/api/.default
